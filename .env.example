# ─── App ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Database (Postgres) ────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/acolhe

# ─── Auth ───────────────────────────────────────────────
AUTH_SECRET=change-me-32-chars-min
AUTH_TRUST_HOST=true

# ─── WhatsApp (Meta Cloud API) ──────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Dev mode bypass — when true, OTP code is logged to console instead of sent
WHATSAPP_DEV_MODE=true

# ─── Stripe ─────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PRO=

# ─── Anthropic (Claude) ─────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Rate-limit (Upstash) ───────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
